{
  "$defs": {
    "ASRInfo": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "engine": {
          "minLength": 1,
          "title": "Engine",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "engine",
        "version"
      ],
      "title": "ASRInfo",
      "type": "object"
    },
    "AudioRenderingSummary": {
      "additionalProperties": false,
      "properties": {
        "n_items_with_audio": {
          "minimum": 0,
          "title": "N Items With Audio",
          "type": "integer"
        },
        "renderings": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Renderings",
          "type": "array"
        }
      },
      "required": [
        "n_items_with_audio"
      ],
      "title": "AudioRenderingSummary",
      "type": "object"
    },
    "DatasetRef": {
      "additionalProperties": false,
      "properties": {
        "benchmark_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Benchmark Manifest Sha256",
          "type": "string"
        },
        "dataset_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dataset Hash",
          "type": "string"
        },
        "item_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Item Ids",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "split": {
          "$ref": "#/$defs/Split"
        },
        "split_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Split Hash",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "split",
        "benchmark_manifest_sha256",
        "dataset_hash",
        "split_hash",
        "item_ids"
      ],
      "title": "DatasetRef",
      "type": "object"
    },
    "EvaluatorArchitecture": {
      "enum": [
        "A",
        "A+",
        "B",
        "K0",
        "MOCK"
      ],
      "title": "EvaluatorArchitecture",
      "type": "string"
    },
    "EvaluatorRunConfig": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "$ref": "#/$defs/EvaluatorArchitecture"
        },
        "config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "llm_backend": {
          "enum": [
            "none",
            "mock",
            "anthropic"
          ],
          "title": "Llm Backend",
          "type": "string"
        },
        "max_output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Id"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "options": {
          "additionalProperties": true,
          "title": "Options",
          "type": "object"
        },
        "prompt_hashes": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Prompt Hashes",
          "type": "object"
        },
        "retry_policy": {
          "$ref": "#/$defs/RetryPolicy"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Temperature"
        },
        "top_p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "architecture",
        "llm_backend",
        "model_id",
        "temperature",
        "retry_policy",
        "config_hash"
      ],
      "title": "EvaluatorRunConfig",
      "type": "object"
    },
    "GitInfo": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch"
        },
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit",
          "type": "string"
        },
        "dirty": {
          "title": "Dirty",
          "type": "boolean"
        }
      },
      "required": [
        "commit",
        "dirty"
      ],
      "title": "GitInfo",
      "type": "object"
    },
    "GoldRef": {
      "additionalProperties": false,
      "properties": {
        "gold_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Gold Hash",
          "type": "string"
        },
        "gold_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Gold Manifest Sha256",
          "type": "string"
        },
        "gold_version": {
          "minLength": 1,
          "title": "Gold Version",
          "type": "string"
        },
        "split_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Split Hash",
          "type": "string"
        }
      },
      "required": [
        "gold_version",
        "gold_manifest_sha256",
        "gold_hash",
        "split_hash"
      ],
      "title": "GoldRef",
      "type": "object"
    },
    "ProfileRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "minLength": 1,
          "title": "Profile Version",
          "type": "string"
        },
        "rubric_version": {
          "minLength": 1,
          "title": "Rubric Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "status": {
          "enum": [
            "placeholder",
            "draft",
            "frozen"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "rubric_version",
        "sha256",
        "path",
        "status"
      ],
      "title": "ProfileRef",
      "type": "object"
    },
    "Randomization": {
      "additionalProperties": false,
      "properties": {
        "item_order": {
          "enum": [
            "manifest",
            "shuffled"
          ],
          "title": "Item Order",
          "type": "string"
        },
        "rep_seed_derivation": {
          "minLength": 1,
          "title": "Rep Seed Derivation",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "seed",
        "item_order",
        "rep_seed_derivation"
      ],
      "title": "Randomization",
      "type": "object"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "backoff_initial_s": {
          "minimum": 0,
          "title": "Backoff Initial S",
          "type": "number"
        },
        "backoff_multiplier": {
          "minimum": 1,
          "title": "Backoff Multiplier",
          "type": "number"
        },
        "max_attempts": {
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "retry_on": {
          "items": {
            "type": "string"
          },
          "title": "Retry On",
          "type": "array"
        }
      },
      "required": [
        "max_attempts",
        "backoff_initial_s",
        "backoff_multiplier"
      ],
      "title": "RetryPolicy",
      "type": "object"
    },
    "Split": {
      "enum": [
        "dev",
        "holdout",
        "redteam",
        "calibration"
      ],
      "title": "Split",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asr": {
      "anyOf": [
        {
          "$ref": "#/$defs/ASRInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "audio_rendering": {
      "$ref": "#/$defs/AudioRenderingSummary"
    },
    "component_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Component Versions",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset": {
      "$ref": "#/$defs/DatasetRef"
    },
    "environment": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Environment",
      "type": "object"
    },
    "evaluator": {
      "$ref": "#/$defs/EvaluatorRunConfig"
    },
    "git": {
      "$ref": "#/$defs/GitInfo"
    },
    "gold": {
      "anyOf": [
        {
          "$ref": "#/$defs/GoldRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "invocation": {
      "items": {
        "type": "string"
      },
      "title": "Invocation",
      "type": "array"
    },
    "official": {
      "title": "Official",
      "type": "boolean"
    },
    "profile": {
      "$ref": "#/$defs/ProfileRef"
    },
    "purpose": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Purpose"
    },
    "randomization": {
      "$ref": "#/$defs/Randomization"
    },
    "repetitions": {
      "minimum": 1,
      "title": "Repetitions",
      "type": "integer"
    },
    "rubric_version": {
      "minLength": 1,
      "title": "Rubric Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "run_manifest/1.0.0",
      "default": "run_manifest/1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "official",
    "dataset",
    "gold",
    "rubric_version",
    "profile",
    "evaluator",
    "component_versions",
    "git",
    "asr",
    "audio_rendering",
    "repetitions",
    "randomization",
    "environment",
    "invocation"
  ],
  "title": "RunManifest",
  "type": "object"
}

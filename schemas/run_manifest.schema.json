{
  "$defs": {
    "ComponentRef": {
      "additionalProperties": false,
      "description": "An external component whose identity may still be pending sign-off (B-05..B-09).",
      "properties": {
        "blocker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocker"
        },
        "engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "status": {
          "enum": [
            "configured",
            "mock",
            "pending_signoff",
            "not_used"
          ],
          "title": "Status",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "status"
      ],
      "title": "ComponentRef",
      "type": "object"
    },
    "DatasetRef": {
      "additionalProperties": false,
      "properties": {
        "bench_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bench Manifest Sha256",
          "type": "string"
        },
        "dataset_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dataset Hash",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "registries_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Registries Sha256",
          "type": "string"
        },
        "scope": {
          "enum": [
            "dev",
            "private"
          ],
          "title": "Scope",
          "type": "string"
        },
        "split": {
          "$ref": "#/$defs/Split"
        },
        "units": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Units",
          "type": "array"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "split",
        "scope",
        "bench_manifest_sha256",
        "dataset_hash",
        "registries_sha256",
        "units"
      ],
      "title": "DatasetRef",
      "type": "object"
    },
    "GitInfo": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch"
        },
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit",
          "type": "string"
        },
        "dirty": {
          "title": "Dirty",
          "type": "boolean"
        },
        "tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tag"
        }
      },
      "required": [
        "commit",
        "dirty"
      ],
      "title": "GitInfo",
      "type": "object"
    },
    "GoldRef": {
      "additionalProperties": false,
      "properties": {
        "gold_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Gold Hash",
          "type": "string"
        },
        "gold_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Gold Manifest Sha256",
          "type": "string"
        },
        "gold_version": {
          "minLength": 1,
          "title": "Gold Version",
          "type": "string"
        }
      },
      "required": [
        "gold_version",
        "gold_manifest_sha256",
        "gold_hash"
      ],
      "title": "GoldRef",
      "type": "object"
    },
    "HashVerification": {
      "additionalProperties": false,
      "description": "P-8 step 3: hashes verified before the run (recorded; H7).",
      "properties": {
        "bench_manifest": {
          "title": "Bench Manifest",
          "type": "boolean"
        },
        "gold": {
          "title": "Gold",
          "type": "boolean"
        },
        "item_files": {
          "title": "Item Files",
          "type": "boolean"
        },
        "lexicons": {
          "title": "Lexicons",
          "type": "boolean"
        },
        "private_hash_list": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Private Hash List"
        },
        "profile": {
          "title": "Profile",
          "type": "boolean"
        },
        "rubric": {
          "title": "Rubric",
          "type": "boolean"
        },
        "verified_at": {
          "format": "date-time",
          "title": "Verified At",
          "type": "string"
        }
      },
      "required": [
        "verified_at",
        "bench_manifest",
        "item_files",
        "private_hash_list",
        "gold",
        "rubric",
        "profile",
        "lexicons"
      ],
      "title": "HashVerification",
      "type": "object"
    },
    "PendingRef": {
      "additionalProperties": false,
      "properties": {
        "blocker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocker"
        },
        "blocks_locked_run": {
          "title": "Blocks Locked Run",
          "type": "boolean"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "blocks_locked_run"
      ],
      "title": "PendingRef",
      "type": "object"
    },
    "SpecRef": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "minLength": 1,
          "title": "Contract Version",
          "type": "string"
        },
        "lexicons_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Lexicons Sha256",
          "type": "string"
        },
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "profile_is_canonical": {
          "title": "Profile Is Canonical",
          "type": "boolean"
        },
        "profile_path": {
          "minLength": 1,
          "title": "Profile Path",
          "type": "string"
        },
        "profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Sha256",
          "type": "string"
        },
        "profile_version": {
          "minLength": 1,
          "title": "Profile Version",
          "type": "string"
        },
        "rubric_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rubric Sha256",
          "type": "string"
        },
        "rubric_version": {
          "minLength": 1,
          "title": "Rubric Version",
          "type": "string"
        },
        "spec_file_sha256": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Spec File Sha256",
          "type": "object"
        }
      },
      "required": [
        "contract_version",
        "rubric_version",
        "rubric_sha256",
        "profile_id",
        "profile_version",
        "profile_sha256",
        "profile_path",
        "profile_is_canonical",
        "lexicons_sha256",
        "spec_file_sha256"
      ],
      "title": "SpecRef",
      "type": "object"
    },
    "Split": {
      "description": "experiment-protocol.md P-1 (dev in-repo; holdout and red team under $BENCH_PRIVATE_DIR).",
      "enum": [
        "dev",
        "holdout",
        "redteam"
      ],
      "title": "Split",
      "type": "string"
    },
    "System": {
      "description": "frozen-contract.md \u00a711.",
      "enum": [
        "K0",
        "A",
        "A+",
        "B"
      ],
      "title": "System",
      "type": "string"
    },
    "SystemConfig": {
      "additionalProperties": false,
      "properties": {
        "consistency_rerun": {
          "const": false,
          "default": false,
          "title": "Consistency Rerun",
          "type": "boolean"
        },
        "derived_from": {
          "anyOf": [
            {
              "const": "A",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derived From"
        },
        "llm_backend": {
          "enum": [
            "none",
            "mock_replay",
            "anthropic"
          ],
          "title": "Llm Backend",
          "type": "string"
        },
        "max_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "model_snapshot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Snapshot Id"
        },
        "prompt_hashes": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Prompt Hashes",
          "type": "object"
        },
        "rubric_prompt_template_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rubric Prompt Template Version"
        },
        "schema_retries": {
          "default": 0,
          "title": "Schema Retries",
          "type": "integer"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "seed_supported": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed Supported"
        },
        "structured_output": {
          "default": false,
          "title": "Structured Output",
          "type": "boolean"
        },
        "system": {
          "$ref": "#/$defs/System"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "transport_retry": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransportRetryPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "system",
        "version",
        "llm_backend"
      ],
      "title": "SystemConfig",
      "type": "object"
    },
    "TransportRetryPolicy": {
      "additionalProperties": false,
      "description": "P-3: transport errors get up to 3 retries with backoff; logged; not counted as retries.",
      "properties": {
        "backoff_initial_s": {
          "default": 1.0,
          "minimum": 0,
          "title": "Backoff Initial S",
          "type": "number"
        },
        "backoff_multiplier": {
          "default": 2.0,
          "minimum": 1,
          "title": "Backoff Multiplier",
          "type": "number"
        },
        "max_retries": {
          "default": 3,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        }
      },
      "title": "TransportRetryPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alias_mapping_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Alias Mapping Sha256",
      "type": "string"
    },
    "asr": {
      "$ref": "#/$defs/ComponentRef"
    },
    "base_seed": {
      "title": "Base Seed",
      "type": "integer"
    },
    "component_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Component Versions",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset": {
      "$ref": "#/$defs/DatasetRef"
    },
    "diarization": {
      "$ref": "#/$defs/ComponentRef"
    },
    "environment": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Environment",
      "type": "object"
    },
    "frontend_steps_not_implemented": {
      "items": {
        "type": "string"
      },
      "title": "Frontend Steps Not Implemented",
      "type": "array"
    },
    "git": {
      "$ref": "#/$defs/GitInfo"
    },
    "gold": {
      "$ref": "#/$defs/GoldRef"
    },
    "hash_verification": {
      "$ref": "#/$defs/HashVerification"
    },
    "invocation": {
      "items": {
        "type": "string"
      },
      "title": "Invocation",
      "type": "array"
    },
    "kind": {
      "enum": [
        "dev",
        "dev_tuning",
        "locked_holdout",
        "locked_redteam"
      ],
      "title": "Kind",
      "type": "string"
    },
    "locked": {
      "title": "Locked",
      "type": "boolean"
    },
    "ordering": {
      "minLength": 1,
      "title": "Ordering",
      "type": "string"
    },
    "pending_signoff": {
      "items": {
        "$ref": "#/$defs/PendingRef"
      },
      "title": "Pending Signoff",
      "type": "array"
    },
    "price_snapshot": {
      "$ref": "#/$defs/ComponentRef"
    },
    "purpose": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Purpose"
    },
    "repetitions": {
      "minimum": 1,
      "title": "Repetitions",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "run_manifest/2.0.0",
      "default": "run_manifest/2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "spec": {
      "$ref": "#/$defs/SpecRef"
    },
    "systems": {
      "items": {
        "$ref": "#/$defs/SystemConfig"
      },
      "minItems": 1,
      "title": "Systems",
      "type": "array"
    },
    "telephony_simulation": {
      "$ref": "#/$defs/ComponentRef"
    },
    "tuning_round": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tuning Round"
    }
  },
  "required": [
    "run_id",
    "kind",
    "locked",
    "created_at",
    "dataset",
    "gold",
    "spec",
    "systems",
    "asr",
    "diarization",
    "telephony_simulation",
    "price_snapshot",
    "base_seed",
    "repetitions",
    "ordering",
    "alias_mapping_sha256",
    "git",
    "hash_verification"
  ],
  "title": "RunManifest",
  "type": "object"
}

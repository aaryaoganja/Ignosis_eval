{
  "$defs": {
    "AbstentionTarget": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "minLength": 1,
          "title": "Check",
          "type": "string"
        },
        "expected": {
          "enum": [
            "INCONCLUSIVE",
            "OUT_OF_SCOPE",
            "SUSPECTED",
            "NOT_EVALUABLE"
          ],
          "title": "Expected",
          "type": "string"
        }
      },
      "required": [
        "check",
        "expected"
      ],
      "title": "AbstentionTarget",
      "type": "object"
    },
    "Adjudication": {
      "additionalProperties": false,
      "properties": {
        "adjudicated_at": {
          "format": "date-time",
          "title": "Adjudicated At",
          "type": "string"
        },
        "adjudicator_id": {
          "minLength": 1,
          "title": "Adjudicator Id",
          "type": "string"
        },
        "contested_items": {
          "items": {
            "type": "string"
          },
          "title": "Contested Items",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "adjudicator_id",
        "adjudicated_at"
      ],
      "title": "Adjudication",
      "type": "object"
    },
    "AttributionFacts": {
      "additionalProperties": false,
      "description": "Content facts from which the gold-derivation module derives the expected attribution per mode.\n\nThe spec names `attribution_facts` (SD-01) without enumerating fields; these are exactly the inputs\nthe rubric's attribution rules need (registration override, perception test, read-back safeguard).",
      "properties": {
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "readback_safeguard_present": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Readback Safeguard Present"
        },
        "registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Registered"
        },
        "said_heard_material_difference": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Said Heard Material Difference"
        }
      },
      "title": "AttributionFacts",
      "type": "object"
    },
    "DangerousWin": {
      "enum": [
        "NONE",
        "CRITICAL",
        "MATERIAL"
      ],
      "title": "DangerousWin",
      "type": "string"
    },
    "Disposition": {
      "description": "rubric.yaml \u203a outcome_model.observable_dispositions.",
      "enum": [
        "ACKNOWLEDGED",
        "PTP_STATED",
        "PAYMENT_CLAIMED_ALREADY_PAID",
        "PAYMENT_CLAIMED_IN_CALL",
        "DISPUTE_RAISED",
        "HARDSHIP_OR_INABILITY_STATED",
        "SETTLEMENT_REQUESTED",
        "OFFER_AGREED",
        "MANDATE_AGREED",
        "CALLBACK_AGREED",
        "HUMAN_REQUESTED",
        "TRANSFER_ANNOUNCED",
        "REFUSED",
        "STOP_REQUESTED",
        "THIRD_PARTY_REACHED",
        "DEATH_REPORTED",
        "COMPLAINT_RAISED",
        "INCOMPLETE",
        "NON_CONVERSATIONAL"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "GateId": {
      "description": "rubric.yaml \u203a gates.",
      "enum": [
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6",
        "G7",
        "G8",
        "G9"
      ],
      "title": "GateId",
      "type": "string"
    },
    "GateStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "NA",
        "INCONCLUSIVE",
        "OUT_OF_SCOPE"
      ],
      "title": "GateStatus",
      "type": "string"
    },
    "GoldFinding": {
      "additionalProperties": false,
      "description": "A gold defect. `code` may be a non-gate MVP code, a PLT code, or a gate id (to carry the gate's\nevidence elements and attribution facts for SD-14 / SD-16; the gate status itself lives in `gates`).",
      "properties": {
        "anchor_turns": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Anchor Turns",
          "type": "array"
        },
        "attribution_facts": {
          "$ref": "#/$defs/AttributionFacts"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "evidence_elements": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Evidence Elements",
          "type": "object"
        },
        "label_confidence": {
          "default": "Sure",
          "minLength": 1,
          "title": "Label Confidence",
          "type": "string"
        },
        "repair_status": {
          "$ref": "#/$defs/RepairStatus",
          "default": "UNREPAIRED"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "code",
        "anchor_turns",
        "severity"
      ],
      "title": "GoldFinding",
      "type": "object"
    },
    "GoldGate": {
      "additionalProperties": false,
      "properties": {
        "anchor_turns": {
          "items": {
            "type": "integer"
          },
          "title": "Anchor Turns",
          "type": "array"
        },
        "contested": {
          "default": false,
          "title": "Contested",
          "type": "boolean"
        },
        "label_confidence": {
          "default": "Sure",
          "minLength": 1,
          "title": "Label Confidence",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/GateStatus"
        },
        "trigger": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger"
        }
      },
      "required": [
        "status"
      ],
      "title": "GoldGate",
      "type": "object"
    },
    "GoldOutcome": {
      "additionalProperties": false,
      "properties": {
        "dispositions": {
          "items": {
            "$ref": "#/$defs/Disposition"
          },
          "title": "Dispositions",
          "type": "array"
        },
        "positive": {
          "default": false,
          "title": "Positive",
          "type": "boolean"
        }
      },
      "title": "GoldOutcome",
      "type": "object"
    },
    "GoldProvenance": {
      "additionalProperties": false,
      "properties": {
        "case_card_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Card Sha256"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "derived_from_evaluator_output": {
          "const": false,
          "default": false,
          "title": "Derived From Evaluator Output",
          "type": "boolean"
        },
        "labeling_protocol_version": {
          "minLength": 1,
          "title": "Labeling Protocol Version",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "single_labeler": {
          "default": false,
          "title": "Single Labeler",
          "type": "boolean"
        }
      },
      "required": [
        "labeling_protocol_version",
        "created_at"
      ],
      "title": "GoldProvenance",
      "type": "object"
    },
    "GoldTags": {
      "additionalProperties": false,
      "properties": {
        "clean_loss": {
          "default": false,
          "title": "Clean Loss",
          "type": "boolean"
        },
        "dangerous_win": {
          "$ref": "#/$defs/DangerousWin",
          "default": "NONE"
        }
      },
      "title": "GoldTags",
      "type": "object"
    },
    "GoldVerdict": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "#/$defs/Verdict"
        },
        "within_scope_complete": {
          "title": "Within Scope Complete",
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "within_scope_complete"
      ],
      "title": "GoldVerdict",
      "type": "object"
    },
    "LabelerRecord": {
      "additionalProperties": false,
      "properties": {
        "labeled_at": {
          "format": "date-time",
          "title": "Labeled At",
          "type": "string"
        },
        "labeler_id": {
          "minLength": 1,
          "title": "Labeler Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "labeler_x",
            "labeler_y",
            "adjudicator",
            "author"
          ],
          "title": "Role",
          "type": "string"
        },
        "saw_evaluator_outputs": {
          "title": "Saw Evaluator Outputs",
          "type": "boolean"
        }
      },
      "required": [
        "labeler_id",
        "role",
        "labeled_at",
        "saw_evaluator_outputs"
      ],
      "title": "LabelerRecord",
      "type": "object"
    },
    "RepairStatus": {
      "enum": [
        "REPAIRED",
        "UNREPAIRED"
      ],
      "title": "RepairStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "CRITICAL",
        "MAJOR",
        "MINOR",
        "INFORMATIONAL"
      ],
      "title": "Severity",
      "type": "string"
    },
    "Split": {
      "description": "experiment-protocol.md P-1 (dev in-repo; holdout and red team under $BENCH_PRIVATE_DIR).",
      "enum": [
        "dev",
        "holdout",
        "redteam"
      ],
      "title": "Split",
      "type": "string"
    },
    "Verdict": {
      "enum": [
        "CRITICAL_FAIL",
        "NEEDS_ATTENTION",
        "MEETS_BAR",
        "NOT_EVALUABLE"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "abstention_targets": {
      "items": {
        "$ref": "#/$defs/AbstentionTarget"
      },
      "title": "Abstention Targets",
      "type": "array"
    },
    "adjudication": {
      "anyOf": [
        {
          "$ref": "#/$defs/Adjudication"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/GoldFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "gates": {
      "additionalProperties": {
        "$ref": "#/$defs/GoldGate"
      },
      "propertyNames": {
        "$ref": "#/$defs/GateId"
      },
      "title": "Gates",
      "type": "object"
    },
    "inconclusive_checks": {
      "items": {
        "type": "string"
      },
      "title": "Inconclusive Checks",
      "type": "array"
    },
    "item_id": {
      "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$",
      "title": "Item Id",
      "type": "string"
    },
    "labelers": {
      "items": {
        "$ref": "#/$defs/LabelerRecord"
      },
      "minItems": 1,
      "title": "Labelers",
      "type": "array"
    },
    "na_checks": {
      "items": {
        "type": "string"
      },
      "title": "Na Checks",
      "type": "array"
    },
    "oos_checks": {
      "items": {
        "type": "string"
      },
      "title": "Oos Checks",
      "type": "array"
    },
    "outcome": {
      "$ref": "#/$defs/GoldOutcome"
    },
    "provenance": {
      "$ref": "#/$defs/GoldProvenance"
    },
    "schema_version": {
      "const": "gold_label/2.0.0",
      "default": "gold_label/2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "split": {
      "$ref": "#/$defs/Split"
    },
    "tags": {
      "$ref": "#/$defs/GoldTags"
    },
    "verdict": {
      "$ref": "#/$defs/GoldVerdict"
    }
  },
  "required": [
    "item_id",
    "split",
    "gates",
    "verdict",
    "provenance",
    "labelers"
  ],
  "title": "GoldLabel",
  "type": "object"
}

{
  "$defs": {
    "Adjudication": {
      "additionalProperties": false,
      "properties": {
        "adjudicated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjudicated At"
        },
        "adjudicator_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjudicator Id"
        },
        "disagreements": {
          "items": {
            "type": "string"
          },
          "title": "Disagreements",
          "type": "array"
        },
        "method": {
          "anyOf": [
            {
              "$ref": "#/$defs/AdjudicationMethod"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "resolution_notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution Notes"
        }
      },
      "required": [
        "required"
      ],
      "title": "Adjudication",
      "type": "object"
    },
    "AdjudicationMethod": {
      "enum": [
        "consensus",
        "adjudicator_decision",
        "majority"
      ],
      "title": "AdjudicationMethod",
      "type": "string"
    },
    "AttributionTarget": {
      "description": "Which component a defect is attributed to. UNDETERMINED = evidence does not support attribution.",
      "enum": [
        "agent_logic",
        "asr",
        "tts",
        "telephony_audio",
        "customer",
        "upstream_data",
        "undetermined"
      ],
      "title": "AttributionTarget",
      "type": "string"
    },
    "Contested": {
      "additionalProperties": false,
      "properties": {
        "alternative_verdicts": {
          "items": {
            "$ref": "#/$defs/Verdict"
          },
          "title": "Alternative Verdicts",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "status": {
          "$ref": "#/$defs/ContestedStatus",
          "default": "uncontested"
        }
      },
      "title": "Contested",
      "type": "object"
    },
    "ContestedStatus": {
      "enum": [
        "uncontested",
        "contested_resolved",
        "contested_unresolved"
      ],
      "title": "ContestedStatus",
      "type": "string"
    },
    "EvaluabilityStatus": {
      "enum": [
        "evaluable",
        "out_of_scope",
        "inconclusive"
      ],
      "title": "EvaluabilityStatus",
      "type": "string"
    },
    "ExpectedDefect": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "$ref": "#/$defs/AttributionTarget"
        },
        "attribution_determinable": {
          "title": "Attribution Determinable",
          "type": "boolean"
        },
        "defect_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
          "title": "Defect Id",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/ExpectedEvidence"
        },
        "gate_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gate Id"
        },
        "repair_status": {
          "$ref": "#/$defs/RepairStatus",
          "default": "not_repaired"
        },
        "required": {
          "default": true,
          "description": "True: the evaluator must detect it (counts toward recall/misses). False: detection is acceptable but not required.",
          "title": "Required",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "defect_id",
        "severity",
        "attribution",
        "attribution_determinable"
      ],
      "title": "ExpectedDefect",
      "type": "object"
    },
    "ExpectedEvaluability": {
      "additionalProperties": false,
      "properties": {
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/EvaluabilityStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "ExpectedEvaluability",
      "type": "object"
    },
    "ExpectedEvidence": {
      "additionalProperties": false,
      "properties": {
        "acceptable_turn_ids": {
          "description": "Additional turns that are on-target if cited.",
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
            "type": "string"
          },
          "title": "Acceptable Turn Ids",
          "type": "array"
        },
        "audio_spans_ms": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "minimum": 0,
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Audio Spans Ms",
          "type": "array"
        },
        "metadata_fields": {
          "items": {
            "const": "call_start_ts",
            "type": "string"
          },
          "title": "Metadata Fields",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "required_turn_ids": {
          "description": "Turns an evaluator must cite for its evidence to be complete.",
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
            "type": "string"
          },
          "title": "Required Turn Ids",
          "type": "array"
        }
      },
      "title": "ExpectedEvidence",
      "type": "object"
    },
    "ExpectedGate": {
      "additionalProperties": false,
      "properties": {
        "acceptable_statuses": {
          "items": {
            "$ref": "#/$defs/GateStatus"
          },
          "title": "Acceptable Statuses",
          "type": "array"
        },
        "gate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
          "title": "Gate Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/GateStatus"
        }
      },
      "required": [
        "gate_id",
        "status"
      ],
      "title": "ExpectedGate",
      "type": "object"
    },
    "ExpectedOutcome": {
      "additionalProperties": false,
      "properties": {
        "outcome_class": {
          "$ref": "#/$defs/OutcomeClass"
        },
        "outcomes": {
          "items": {
            "$ref": "#/$defs/OutcomeCode"
          },
          "title": "Outcomes",
          "type": "array"
        }
      },
      "required": [
        "outcome_class"
      ],
      "title": "ExpectedOutcome",
      "type": "object"
    },
    "GateStatus": {
      "enum": [
        "pass",
        "fail",
        "inconclusive",
        "not_applicable"
      ],
      "title": "GateStatus",
      "type": "string"
    },
    "GoldProvenance": {
      "additionalProperties": false,
      "properties": {
        "case_card_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Card Ref"
        },
        "case_card_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Card Sha256"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "derived_from_evaluator_output": {
          "const": false,
          "default": false,
          "title": "Derived From Evaluator Output",
          "type": "boolean"
        },
        "labeling_protocol_version": {
          "minLength": 1,
          "title": "Labeling Protocol Version",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "source": {
          "$ref": "#/$defs/GoldSource"
        }
      },
      "required": [
        "source",
        "labeling_protocol_version",
        "created_at"
      ],
      "title": "GoldProvenance",
      "type": "object"
    },
    "GoldSource": {
      "enum": [
        "author_specified",
        "independent_label",
        "adjudicated"
      ],
      "title": "GoldSource",
      "type": "string"
    },
    "LabelConfidence": {
      "enum": [
        "high",
        "moderate",
        "low"
      ],
      "title": "LabelConfidence",
      "type": "string"
    },
    "LabelerRecord": {
      "additionalProperties": false,
      "properties": {
        "blind_to_case_card": {
          "title": "Blind To Case Card",
          "type": "boolean"
        },
        "expertise": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expertise"
        },
        "labeled_at": {
          "format": "date-time",
          "title": "Labeled At",
          "type": "string"
        },
        "labeler_id": {
          "description": "Pseudonymous labeler identifier (no personal data).",
          "minLength": 1,
          "title": "Labeler Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/LabelerRole"
        },
        "saw_evaluator_outputs": {
          "title": "Saw Evaluator Outputs",
          "type": "boolean"
        }
      },
      "required": [
        "labeler_id",
        "role",
        "labeled_at",
        "blind_to_case_card",
        "saw_evaluator_outputs"
      ],
      "title": "LabelerRecord",
      "type": "object"
    },
    "LabelerRole": {
      "enum": [
        "author",
        "labeler",
        "adjudicator"
      ],
      "title": "LabelerRole",
      "type": "string"
    },
    "OutcomeClass": {
      "enum": [
        "win",
        "loss",
        "neutral",
        "unknown"
      ],
      "title": "OutcomeClass",
      "type": "string"
    },
    "OutcomeCode": {
      "enum": [
        "promise_to_pay",
        "payment_committed_on_call",
        "payment_plan_agreed",
        "dispute_raised",
        "callback_scheduled",
        "refusal_to_pay",
        "wrong_party",
        "hardship_disclosed",
        "no_resolution",
        "call_dropped"
      ],
      "title": "OutcomeCode",
      "type": "string"
    },
    "RepairStatus": {
      "enum": [
        "not_repaired",
        "partially_repaired",
        "repaired",
        "not_applicable"
      ],
      "title": "RepairStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "critical",
        "major",
        "minor"
      ],
      "title": "Severity",
      "type": "string"
    },
    "Split": {
      "enum": [
        "dev",
        "holdout",
        "redteam",
        "calibration"
      ],
      "title": "Split",
      "type": "string"
    },
    "Verdict": {
      "enum": [
        "pass",
        "fail",
        "inconclusive",
        "out_of_scope"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acceptable_extra_defects": {
      "description": "Defect ids that are defensible if an evaluator raises them (not counted as unsupported).",
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
        "type": "string"
      },
      "title": "Acceptable Extra Defects",
      "type": "array"
    },
    "acceptable_verdicts": {
      "items": {
        "$ref": "#/$defs/Verdict"
      },
      "title": "Acceptable Verdicts",
      "type": "array"
    },
    "adjudication": {
      "anyOf": [
        {
          "$ref": "#/$defs/Adjudication"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "confidence": {
      "$ref": "#/$defs/LabelConfidence"
    },
    "contested": {
      "$ref": "#/$defs/Contested"
    },
    "expected_clean_loss": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Clean Loss"
    },
    "expected_dangerous_win": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Dangerous Win"
    },
    "expected_defects": {
      "items": {
        "$ref": "#/$defs/ExpectedDefect"
      },
      "title": "Expected Defects",
      "type": "array"
    },
    "expected_evaluability": {
      "$ref": "#/$defs/ExpectedEvaluability"
    },
    "expected_gates": {
      "items": {
        "$ref": "#/$defs/ExpectedGate"
      },
      "title": "Expected Gates",
      "type": "array"
    },
    "expected_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExpectedOutcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expected_primary_attribution": {
      "anyOf": [
        {
          "$ref": "#/$defs/AttributionTarget"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expected_verdict": {
      "$ref": "#/$defs/Verdict"
    },
    "item_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "title": "Item Id",
      "type": "string"
    },
    "labelers": {
      "items": {
        "$ref": "#/$defs/LabelerRecord"
      },
      "minItems": 1,
      "title": "Labelers",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/GoldProvenance"
    },
    "scenario": {
      "minLength": 1,
      "title": "Scenario",
      "type": "string"
    },
    "schema_version": {
      "const": "gold_label/1.0.0",
      "default": "gold_label/1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "split": {
      "$ref": "#/$defs/Split"
    }
  },
  "required": [
    "item_id",
    "split",
    "scenario",
    "expected_evaluability",
    "expected_verdict",
    "confidence",
    "provenance",
    "labelers"
  ],
  "title": "GoldLabel",
  "type": "object"
}

{
  "$defs": {
    "GoldManifestEntry": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$",
          "title": "Item Id",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "split": {
          "$ref": "#/$defs/Split"
        }
      },
      "required": [
        "item_id",
        "split",
        "path",
        "sha256"
      ],
      "title": "GoldManifestEntry",
      "type": "object"
    },
    "Split": {
      "description": "experiment-protocol.md P-1 (dev in-repo; holdout and red team under $BENCH_PRIVATE_DIR).",
      "enum": [
        "dev",
        "holdout",
        "redteam"
      ],
      "title": "Split",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bench_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bench Manifest Sha256",
      "type": "string"
    },
    "dataset_name": {
      "minLength": 1,
      "title": "Dataset Name",
      "type": "string"
    },
    "dataset_version": {
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/GoldManifestEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "frozen_at": {
      "format": "date-time",
      "title": "Frozen At",
      "type": "string"
    },
    "frozen_by": {
      "minLength": 1,
      "title": "Frozen By",
      "type": "string"
    },
    "gold_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Gold Hash",
      "type": "string"
    },
    "gold_version": {
      "minLength": 1,
      "title": "Gold Version",
      "type": "string"
    },
    "labeling_protocol_version": {
      "minLength": 1,
      "title": "Labeling Protocol Version",
      "type": "string"
    },
    "schema_version": {
      "const": "gold_manifest/2.0.0",
      "default": "gold_manifest/2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "enum": [
        "dev",
        "private"
      ],
      "title": "Scope",
      "type": "string"
    }
  },
  "required": [
    "gold_version",
    "scope",
    "dataset_name",
    "dataset_version",
    "bench_manifest_sha256",
    "labeling_protocol_version",
    "frozen_at",
    "frozen_by",
    "entries",
    "gold_hash"
  ],
  "title": "GoldManifest",
  "type": "object"
}

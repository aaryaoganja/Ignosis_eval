{
  "$defs": {
    "GoldManifestEntry": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
          "title": "Item Id",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "split": {
          "$ref": "#/$defs/Split"
        }
      },
      "required": [
        "item_id",
        "split",
        "path",
        "sha256"
      ],
      "title": "GoldManifestEntry",
      "type": "object"
    },
    "Split": {
      "enum": [
        "dev",
        "holdout",
        "redteam",
        "calibration"
      ],
      "title": "Split",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "benchmark_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Benchmark Manifest Sha256",
      "type": "string"
    },
    "dataset_name": {
      "minLength": 1,
      "title": "Dataset Name",
      "type": "string"
    },
    "dataset_version": {
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/GoldManifestEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "frozen_at": {
      "format": "date-time",
      "title": "Frozen At",
      "type": "string"
    },
    "frozen_by": {
      "minLength": 1,
      "title": "Frozen By",
      "type": "string"
    },
    "gold_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Gold Hash",
      "type": "string"
    },
    "gold_version": {
      "minLength": 1,
      "title": "Gold Version",
      "type": "string"
    },
    "labeling_protocol_version": {
      "minLength": 1,
      "title": "Labeling Protocol Version",
      "type": "string"
    },
    "schema_version": {
      "const": "gold_manifest/1.0.0",
      "default": "gold_manifest/1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "split_hashes": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "propertyNames": {
        "$ref": "#/$defs/Split"
      },
      "title": "Split Hashes",
      "type": "object"
    }
  },
  "required": [
    "gold_version",
    "dataset_name",
    "dataset_version",
    "benchmark_manifest_sha256",
    "labeling_protocol_version",
    "frozen_at",
    "frozen_by",
    "entries",
    "split_hashes",
    "gold_hash"
  ],
  "title": "GoldManifest",
  "type": "object"
}

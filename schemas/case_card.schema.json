{
  "$defs": {
    "AttributionFacts": {
      "additionalProperties": false,
      "description": "Content facts from which the gold-derivation module derives the expected attribution per mode.\n\nThe spec names `attribution_facts` (SD-01) without enumerating fields; these are exactly the inputs\nthe rubric's attribution rules need (registration override, perception test, read-back safeguard).",
      "properties": {
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "readback_safeguard_present": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Readback Safeguard Present"
        },
        "registered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Registered"
        },
        "said_heard_material_difference": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Said Heard Material Difference"
        }
      },
      "title": "AttributionFacts",
      "type": "object"
    },
    "Authoring": {
      "additionalProperties": false,
      "properties": {
        "author_id": {
          "minLength": 1,
          "title": "Author Id",
          "type": "string"
        },
        "created_on": {
          "format": "date",
          "title": "Created On",
          "type": "string"
        },
        "llm_assisted": {
          "default": false,
          "title": "Llm Assisted",
          "type": "boolean"
        },
        "llm_family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Family"
        },
        "reviewers": {
          "items": {
            "type": "string"
          },
          "title": "Reviewers",
          "type": "array"
        }
      },
      "required": [
        "author_id",
        "created_on"
      ],
      "title": "Authoring",
      "type": "object"
    },
    "CardOutcome": {
      "additionalProperties": false,
      "properties": {
        "dispositions": {
          "items": {
            "$ref": "#/$defs/Disposition"
          },
          "title": "Dispositions",
          "type": "array"
        },
        "positive": {
          "default": false,
          "title": "Positive",
          "type": "boolean"
        }
      },
      "title": "CardOutcome",
      "type": "object"
    },
    "CardStatus": {
      "enum": [
        "draft",
        "in_review",
        "approved"
      ],
      "title": "CardStatus",
      "type": "string"
    },
    "DangerousWin": {
      "enum": [
        "NONE",
        "CRITICAL",
        "MATERIAL"
      ],
      "title": "DangerousWin",
      "type": "string"
    },
    "Disposition": {
      "description": "rubric.yaml \u203a outcome_model.observable_dispositions.",
      "enum": [
        "ACKNOWLEDGED",
        "PTP_STATED",
        "PAYMENT_CLAIMED_ALREADY_PAID",
        "PAYMENT_CLAIMED_IN_CALL",
        "DISPUTE_RAISED",
        "HARDSHIP_OR_INABILITY_STATED",
        "SETTLEMENT_REQUESTED",
        "OFFER_AGREED",
        "MANDATE_AGREED",
        "CALLBACK_AGREED",
        "HUMAN_REQUESTED",
        "TRANSFER_ANNOUNCED",
        "REFUSED",
        "STOP_REQUESTED",
        "THIRD_PARTY_REACHED",
        "DEATH_REPORTED",
        "COMPLAINT_RAISED",
        "INCOMPLETE",
        "NON_CONVERSATIONAL"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "EvaluabilityStatus": {
      "enum": [
        "EVALUABLE",
        "PARTIAL",
        "NOT_EVALUABLE"
      ],
      "title": "EvaluabilityStatus",
      "type": "string"
    },
    "GateId": {
      "description": "rubric.yaml \u203a gates.",
      "enum": [
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6",
        "G7",
        "G8",
        "G9"
      ],
      "title": "GateId",
      "type": "string"
    },
    "Pack": {
      "description": "frozen-contract.md \u00a712 packs.",
      "enum": [
        "core",
        "micro",
        "abstention",
        "modality",
        "language_twin",
        "snippet",
        "redteam",
        "calibration"
      ],
      "title": "Pack",
      "type": "string"
    },
    "PairMembership": {
      "additionalProperties": false,
      "properties": {
        "counterpart_item_id": {
          "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$",
          "title": "Counterpart Item Id",
          "type": "string"
        },
        "pair_id": {
          "minLength": 1,
          "title": "Pair Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "clean",
            "violating"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "pair_id",
        "role",
        "counterpart_item_id"
      ],
      "title": "PairMembership",
      "type": "object"
    },
    "ReasonCode": {
      "enum": [
        "ROLE_UNCERTAIN",
        "TRANSCRIPT_UNRELIABLE",
        "AUDIO_POOR",
        "SPAN_UNRELIABLE",
        "NON_CONVERSATIONAL",
        "CONTRADICTORY_EVIDENCE",
        "POLICY_UNKNOWN",
        "EXTERNAL_DATA_REQUIRED",
        "LANGUAGE_UNSUPPORTED",
        "TRANSCRIPT_TRUNCATED",
        "STAGE_UNKNOWN"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "RepairStatus": {
      "enum": [
        "REPAIRED",
        "UNREPAIRED"
      ],
      "title": "RepairStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "CRITICAL",
        "MAJOR",
        "MINOR",
        "INFORMATIONAL"
      ],
      "title": "Severity",
      "type": "string"
    },
    "Split": {
      "description": "experiment-protocol.md P-1 (dev in-repo; holdout and red team under $BENCH_PRIVATE_DIR).",
      "enum": [
        "dev",
        "holdout",
        "redteam"
      ],
      "title": "Split",
      "type": "string"
    },
    "UnitMode": {
      "description": "Unit modes (experiment-protocol P-5). Directory-safe spelling of `A+T(platform)` is `A+T-platform`.",
      "enum": [
        "TRANSCRIPT",
        "T-gold",
        "T-asr",
        "A",
        "A+T",
        "A+T-platform"
      ],
      "title": "UnitMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ambiguity_notes": {
      "minLength": 1,
      "title": "Ambiguity Notes",
      "type": "string"
    },
    "attribution_facts": {
      "$ref": "#/$defs/AttributionFacts"
    },
    "authoring": {
      "$ref": "#/$defs/Authoring"
    },
    "case_card_version": {
      "const": "case_card/2.0.0",
      "default": "case_card/2.0.0",
      "title": "Case Card Version",
      "type": "string"
    },
    "clean_loss": {
      "default": false,
      "title": "Clean Loss",
      "type": "boolean"
    },
    "control_target_gates": {
      "items": {
        "$ref": "#/$defs/GateId"
      },
      "title": "Control Target Gates",
      "type": "array"
    },
    "dangerous_win": {
      "$ref": "#/$defs/DangerousWin",
      "default": "NONE"
    },
    "evidence_header": {
      "default": false,
      "title": "Evidence Header",
      "type": "boolean"
    },
    "evidence_turns": {
      "items": {
        "type": "integer"
      },
      "title": "Evidence Turns",
      "type": "array"
    },
    "expected_evaluability": {
      "$ref": "#/$defs/EvaluabilityStatus",
      "default": "EVALUABLE"
    },
    "expected_reason_codes": {
      "items": {
        "$ref": "#/$defs/ReasonCode"
      },
      "title": "Expected Reason Codes",
      "type": "array"
    },
    "intent": {
      "minLength": 1,
      "title": "Intent",
      "type": "string"
    },
    "item_id": {
      "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$",
      "title": "Item Id",
      "type": "string"
    },
    "language": {
      "enum": [
        "en",
        "hi",
        "hi-en",
        "other"
      ],
      "title": "Language",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/CardOutcome"
    },
    "pack": {
      "$ref": "#/$defs/Pack"
    },
    "pair": {
      "anyOf": [
        {
          "$ref": "#/$defs/PairMembership"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "repair_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/RepairStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "scenario": {
      "minLength": 1,
      "title": "Scenario",
      "type": "string"
    },
    "severity": {
      "anyOf": [
        {
          "$ref": "#/$defs/Severity"
        },
        {
          "type": "null"
        }
      ]
    },
    "split": {
      "$ref": "#/$defs/Split"
    },
    "status": {
      "$ref": "#/$defs/CardStatus"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "target_behavior": {
      "minLength": 1,
      "title": "Target Behavior",
      "type": "string"
    },
    "target_check": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Target Check"
    },
    "target_sub_rule": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Sub Rule"
    },
    "twin_of": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Twin Of"
    },
    "unit_modes": {
      "items": {
        "$ref": "#/$defs/UnitMode"
      },
      "minItems": 1,
      "title": "Unit Modes",
      "type": "array"
    }
  },
  "required": [
    "item_id",
    "status",
    "authoring",
    "split",
    "pack",
    "language",
    "unit_modes",
    "intent",
    "rationale",
    "scenario",
    "target_behavior",
    "target_check",
    "severity",
    "repair_status",
    "ambiguity_notes"
  ],
  "title": "CaseCard",
  "type": "object"
}

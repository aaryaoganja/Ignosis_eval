{
  "$defs": {
    "ActionType": {
      "enum": [
        "REVIEW",
        "REMEDIATE",
        "FIX"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "Attribution": {
      "enum": [
        "AGENT_BEHAVIOR",
        "PERCEPTION",
        "PLATFORM_AUDIO",
        "CUSTOMER_DRIVEN",
        "INDETERMINATE"
      ],
      "title": "Attribution",
      "type": "string"
    },
    "AttributionBasis": {
      "enum": [
        "RUBRIC",
        "PROFILE_DEFAULT",
        "DECLARED_PROVENANCE"
      ],
      "title": "AttributionBasis",
      "type": "string"
    },
    "AttributionResult": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/AttributionBasis"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "primary": {
          "$ref": "#/$defs/Attribution"
        },
        "secondary": {
          "anyOf": [
            {
              "$ref": "#/$defs/Attribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "primary",
        "basis"
      ],
      "title": "AttributionResult",
      "type": "object"
    },
    "CheckStatusEntry": {
      "additionalProperties": false,
      "description": "Explicit non-default status of a non-gate check (NA / INCONCLUSIVE / OUT_OF_SCOPE).\n\nSD-02: a code absent from the record means \"not emitted\" (PASS). A DEFECT is expressed by an\nASSERTED finding, not by an entry here.",
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "oos_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/OosReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "status": {
          "enum": [
            "NA",
            "INCONCLUSIVE",
            "OUT_OF_SCOPE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "code",
        "status"
      ],
      "title": "CheckStatusEntry",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "CriticalStatus": {
      "enum": [
        "CONFIRMED",
        "SUSPECTED"
      ],
      "title": "CriticalStatus",
      "type": "string"
    },
    "DangerousWin": {
      "enum": [
        "NONE",
        "CRITICAL",
        "MATERIAL"
      ],
      "title": "DangerousWin",
      "type": "string"
    },
    "DimensionStatus": {
      "enum": [
        "CLEAN",
        "MINOR",
        "MAJOR",
        "POSSIBLE",
        "INCONCLUSIVE",
        "NA",
        "OUT_OF_SCOPE"
      ],
      "title": "DimensionStatus",
      "type": "string"
    },
    "Disposition": {
      "description": "rubric.yaml \u203a outcome_model.observable_dispositions.",
      "enum": [
        "ACKNOWLEDGED",
        "PTP_STATED",
        "PAYMENT_CLAIMED_ALREADY_PAID",
        "PAYMENT_CLAIMED_IN_CALL",
        "DISPUTE_RAISED",
        "HARDSHIP_OR_INABILITY_STATED",
        "SETTLEMENT_REQUESTED",
        "OFFER_AGREED",
        "MANDATE_AGREED",
        "CALLBACK_AGREED",
        "HUMAN_REQUESTED",
        "TRANSFER_ANNOUNCED",
        "REFUSED",
        "STOP_REQUESTED",
        "THIRD_PARTY_REACHED",
        "DEATH_REPORTED",
        "COMPLAINT_RAISED",
        "INCOMPLETE",
        "NON_CONVERSATIONAL"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "EvaluabilityResult": {
      "additionalProperties": false,
      "properties": {
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/EvaluabilityStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "EvaluabilityResult",
      "type": "object"
    },
    "EvaluabilityStatus": {
      "enum": [
        "EVALUABLE",
        "PARTIAL",
        "NOT_EVALUABLE"
      ],
      "title": "EvaluabilityStatus",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "A cited span. `turn` is the 1-based turn number of the normalized input (SD-12 anchors use it).",
      "properties": {
        "element": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Element"
        },
        "header_field": {
          "anyOf": [
            {
              "const": "call_start_ts",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Field"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/Role"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "supplied",
                "asr"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "turn": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turn"
        }
      },
      "title": "Evidence",
      "type": "object"
    },
    "ExperimentMeta": {
      "additionalProperties": false,
      "description": "Attached by the runner; systems leave this null.",
      "properties": {
        "base_seed": {
          "title": "Base Seed",
          "type": "integer"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "repetition": {
          "minimum": 1,
          "title": "Repetition",
          "type": "integer"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "unit_mode": {
          "$ref": "#/$defs/UnitMode"
        }
      },
      "required": [
        "run_id",
        "item_id",
        "unit_mode",
        "repetition",
        "base_seed",
        "started_at",
        "finished_at"
      ],
      "title": "ExperimentMeta",
      "type": "object"
    },
    "FailureInfo": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "schema_attempts": {
          "minimum": 0,
          "title": "Schema Attempts",
          "type": "integer"
        }
      },
      "required": [
        "reason",
        "schema_attempts"
      ],
      "title": "FailureInfo",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "$ref": "#/$defs/ActionType"
        },
        "anchor_turn": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor Turn"
        },
        "attribution": {
          "$ref": "#/$defs/AttributionResult"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "evidence_unverified": {
          "default": false,
          "title": "Evidence Unverified",
          "type": "boolean"
        },
        "finding_state": {
          "$ref": "#/$defs/FindingState",
          "default": "ASSERTED"
        },
        "repair_status": {
          "$ref": "#/$defs/RepairStatus",
          "default": "UNREPAIRED"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "sub_rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sub Rule"
        }
      },
      "required": [
        "code",
        "severity",
        "confidence",
        "action_type",
        "attribution",
        "evidence"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingState": {
      "enum": [
        "ASSERTED",
        "POSSIBLE"
      ],
      "title": "FindingState",
      "type": "string"
    },
    "Firmness": {
      "description": "rubric.yaml \u203a extraction_vocabulary.firmness.",
      "enum": [
        "firm",
        "soft",
        "conditional"
      ],
      "title": "Firmness",
      "type": "string"
    },
    "GateId": {
      "description": "rubric.yaml \u203a gates.",
      "enum": [
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6",
        "G7",
        "G8",
        "G9"
      ],
      "title": "GateId",
      "type": "string"
    },
    "GateResult": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttributionResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Confidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "critical_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/CriticalStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "evidence_unverified": {
          "default": false,
          "title": "Evidence Unverified",
          "type": "boolean"
        },
        "gate": {
          "$ref": "#/$defs/GateId"
        },
        "in_span_trigger": {
          "default": false,
          "title": "In Span Trigger",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "oos_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/OosReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/GateStatus"
        },
        "sub_rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sub Rule"
        }
      },
      "required": [
        "gate",
        "status"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "GateStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "NA",
        "INCONCLUSIVE",
        "OUT_OF_SCOPE"
      ],
      "title": "GateStatus",
      "type": "string"
    },
    "InputMode": {
      "enum": [
        "AUDIO",
        "TRANSCRIPT",
        "AUDIO_TRANSCRIPT"
      ],
      "title": "InputMode",
      "type": "string"
    },
    "OosReason": {
      "enum": [
        "EXTERNAL_DATA_REQUIRED",
        "MODE_CAPABILITY"
      ],
      "title": "OosReason",
      "type": "string"
    },
    "OutOfScopeEntry": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "oos_reason": {
          "$ref": "#/$defs/OosReason"
        }
      },
      "required": [
        "code",
        "oos_reason"
      ],
      "title": "OutOfScopeEntry",
      "type": "object"
    },
    "Outcome": {
      "additionalProperties": false,
      "properties": {
        "commitment_turn": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commitment Turn"
        },
        "dispositions": {
          "items": {
            "$ref": "#/$defs/Disposition"
          },
          "title": "Dispositions",
          "type": "array"
        },
        "firmness": {
          "anyOf": [
            {
              "$ref": "#/$defs/Firmness"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome_attribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutcomeAttribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "positive": {
          "default": false,
          "title": "Positive",
          "type": "boolean"
        },
        "verified": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified"
        }
      },
      "title": "Outcome",
      "type": "object"
    },
    "OutcomeAttribution": {
      "enum": [
        "AGENT_DRIVEN",
        "CUSTOMER_DRIVEN",
        "POLICY_DRIVEN",
        "INDETERMINATE"
      ],
      "title": "OutcomeAttribution",
      "type": "string"
    },
    "ReasonCode": {
      "enum": [
        "ROLE_UNCERTAIN",
        "TRANSCRIPT_UNRELIABLE",
        "AUDIO_POOR",
        "SPAN_UNRELIABLE",
        "NON_CONVERSATIONAL",
        "CONTRADICTORY_EVIDENCE",
        "POLICY_UNKNOWN",
        "EXTERNAL_DATA_REQUIRED",
        "LANGUAGE_UNSUPPORTED",
        "TRANSCRIPT_TRUNCATED",
        "STAGE_UNKNOWN"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "RecordStatus": {
      "enum": [
        "OK",
        "EVALUATION_FAILED"
      ],
      "title": "RecordStatus",
      "type": "string"
    },
    "RepairStatus": {
      "enum": [
        "REPAIRED",
        "UNREPAIRED"
      ],
      "title": "RepairStatus",
      "type": "string"
    },
    "Role": {
      "description": "frozen-contract.md \u00a72.3 role labels (CUSTOMER is an accepted alias of BORROWER at parse time).",
      "enum": [
        "AGENT",
        "BORROWER",
        "OTHER",
        "UNKNOWN"
      ],
      "title": "Role",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "CRITICAL",
        "MAJOR",
        "MINOR",
        "INFORMATIONAL"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SystemInfo": {
      "additionalProperties": false,
      "properties": {
        "model_snapshot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Snapshot Id"
        },
        "prompt_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Prompt Hashes",
          "type": "object"
        },
        "system": {
          "minLength": 1,
          "title": "System",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "system",
        "version"
      ],
      "title": "SystemInfo",
      "type": "object"
    },
    "Tags": {
      "additionalProperties": false,
      "properties": {
        "clean_loss": {
          "default": false,
          "title": "Clean Loss",
          "type": "boolean"
        },
        "coverage": {
          "const": "conversation_only",
          "default": "conversation_only",
          "title": "Coverage",
          "type": "string"
        },
        "dangerous_win": {
          "$ref": "#/$defs/DangerousWin",
          "default": "NONE"
        },
        "high_friction": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High Friction"
        }
      },
      "title": "Tags",
      "type": "object"
    },
    "UnitMode": {
      "description": "Unit modes (experiment-protocol P-5). Directory-safe spelling of `A+T(platform)` is `A+T-platform`.",
      "enum": [
        "TRANSCRIPT",
        "T-gold",
        "T-asr",
        "A",
        "A+T",
        "A+T-platform"
      ],
      "title": "UnitMode",
      "type": "string"
    },
    "Verdict": {
      "enum": [
        "CRITICAL_FAIL",
        "NEEDS_ATTENTION",
        "MEETS_BAR",
        "NOT_EVALUABLE"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/CheckStatusEntry"
      },
      "title": "Checks",
      "type": "array"
    },
    "contract_version": {
      "minLength": 1,
      "title": "Contract Version",
      "type": "string"
    },
    "critical_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/CriticalStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "dimensions": {
      "additionalProperties": {
        "$ref": "#/$defs/DimensionStatus"
      },
      "title": "Dimensions",
      "type": "object"
    },
    "evaluability": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvaluabilityResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "experiment": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExperimentMeta"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "title": "Gates",
      "type": "array"
    },
    "input_mode": {
      "$ref": "#/$defs/InputMode"
    },
    "out_of_scope": {
      "items": {
        "$ref": "#/$defs/OutOfScopeEntry"
      },
      "title": "Out Of Scope",
      "type": "array"
    },
    "outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/Outcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "profile_version": {
      "minLength": 1,
      "title": "Profile Version",
      "type": "string"
    },
    "record_status": {
      "$ref": "#/$defs/RecordStatus"
    },
    "routing_tier": {
      "anyOf": [
        {
          "maximum": 6,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Routing Tier"
    },
    "rubric_version": {
      "minLength": 1,
      "title": "Rubric Version",
      "type": "string"
    },
    "schema_version": {
      "const": "evaluation_record/2.0.0",
      "default": "evaluation_record/2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "system": {
      "$ref": "#/$defs/SystemInfo"
    },
    "tags": {
      "anyOf": [
        {
          "$ref": "#/$defs/Tags"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "unit_mode": {
      "$ref": "#/$defs/UnitMode"
    },
    "unverified_agent_commitments": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Unverified Agent Commitments",
      "type": "array"
    },
    "verdict": {
      "anyOf": [
        {
          "$ref": "#/$defs/Verdict"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "within_scope_complete": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Within Scope Complete"
    }
  },
  "required": [
    "record_status",
    "system",
    "contract_version",
    "rubric_version",
    "profile_id",
    "profile_version",
    "input_mode",
    "unit_mode"

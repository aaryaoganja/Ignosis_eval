{
  "$defs": {
    "CallingWindow": {
      "additionalProperties": true,
      "properties": {
        "end": {
          "pattern": "^\\d{2}:\\d{2}$",
          "title": "End",
          "type": "string"
        },
        "requires": {
          "title": "Requires",
          "type": "string"
        },
        "start": {
          "pattern": "^\\d{2}:\\d{2}$",
          "title": "Start",
          "type": "string"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "timezone",
        "requires"
      ],
      "title": "CallingWindow",
      "type": "object"
    },
    "Consequences": {
      "additionalProperties": true,
      "properties": {
        "permitted_categories": {
          "items": {
            "type": "string"
          },
          "title": "Permitted Categories",
          "type": "array"
        },
        "prohibited_categories": {
          "additionalProperties": {
            "enum": [
              "G2",
              "G3"
            ],
            "type": "string"
          },
          "title": "Prohibited Categories",
          "type": "object"
        }
      },
      "required": [
        "permitted_categories",
        "prohibited_categories"
      ],
      "title": "Consequences",
      "type": "object"
    },
    "Offers": {
      "additionalProperties": true,
      "properties": {
        "allowed": {
          "items": {
            "type": "string"
          },
          "title": "Allowed",
          "type": "array"
        },
        "authority_unknown": {
          "items": {
            "type": "string"
          },
          "title": "Authority Unknown",
          "type": "array"
        },
        "not_ai_authorized": {
          "items": {
            "type": "string"
          },
          "title": "Not Ai Authorized",
          "type": "array"
        }
      },
      "required": [
        "not_ai_authorized",
        "authority_unknown",
        "allowed"
      ],
      "title": "Offers",
      "type": "object"
    },
    "ThresholdSpec": {
      "additionalProperties": true,
      "properties": {
        "decision_required": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Required"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "const": "PENDING_HUMAN_SIGNOFF",
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "ThresholdSpec",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "asks": {
      "additionalProperties": true,
      "title": "Asks",
      "type": "object"
    },
    "calling_window": {
      "$ref": "#/$defs/CallingWindow"
    },
    "consequences": {
      "$ref": "#/$defs/Consequences"
    },
    "disclosures": {

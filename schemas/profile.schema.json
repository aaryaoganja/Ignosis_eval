      "additionalProperties": true,
      "title": "Identity Verification",
      "type": "object"
    },
    "languages_supported": {
      "items": {
        "type": "string"
      },
      "title": "Languages Supported",
      "type": "array"
    },
    "lexicons": {
      "additionalProperties": true,
      "title": "Lexicons",
      "type": "object"
    },
    "offers": {
      "$ref": "#/$defs/Offers"
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "profile_version": {
      "title": "Profile Version",
      "type": "string"
    },
    "prohibited_phrases": {
      "additionalProperties": true,
      "title": "Prohibited Phrases",
      "type": "object"
    },
    "ptp": {
      "additionalProperties": true,
      "title": "Ptp",
      "type": "object"
    },
    "rights": {
      "additionalProperties": true,
      "title": "Rights",
      "type": "object"
    },
    "rubric_ref": {
      "title": "Rubric Ref",
      "type": "string"
    },
    "scenario_paths": {
      "additionalProperties": true,
      "title": "Scenario Paths",
      "type": "object"
    },
    "thresholds": {
      "additionalProperties": {
        "$ref": "#/$defs/ThresholdSpec"
      },
      "title": "Thresholds",
      "type": "object"
    },
    "use_case": {

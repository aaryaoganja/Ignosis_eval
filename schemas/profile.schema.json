    "use_case",
    "identity_verification",
    "asks",
    "ptp",
    "offers",
    "consequences",
    "rights",
    "vulnerability_protocol",
    "escalation_triggers",
    "disclosures",
    "prohibited_phrases",
    "calling_window",
    "languages_supported",
    "scenario_paths",
    "thresholds",

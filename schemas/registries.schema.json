{
  "$defs": {
    "ControlEntry": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$",
          "title": "Item Id",
          "type": "string"
        },
        "target_gates": {
          "items": {
            "$ref": "#/$defs/GateId"
          },
          "minItems": 1,
          "title": "Target Gates",
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "target_gates"
      ],
      "title": "ControlEntry",
      "type": "object"
    },
    "GateId": {
      "description": "rubric.yaml \u203a gates.",
      "enum": [
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6",
        "G7",
        "G8",
        "G9"
      ],
      "title": "GateId",
      "type": "string"
    },
    "IncidentalDifference": {
      "additionalProperties": false,
      "description": "A declared difference between pair members that does not define the pair target (BD-03, BD-04;\ndocs/bd-changelog.md). `aspect` borrower_context: a customer-side context turn (`where` = design beat, e.g. B4);\ncall_start_ts_header: the header is present on one member only (`where` = the check it moves, G7).",
      "properties": {
        "aspect": {
          "enum": [
            "borrower_context",
            "call_start_ts_header"
          ],
          "title": "Aspect",
          "type": "string"
        },
        "basis": {
          "pattern": "^BD-\\d{2}$",
          "title": "Basis",
          "type": "string"
        },
        "where": {
          "minLength": 1,
          "title": "Where",
          "type": "string"
        }
      },
      "required": [
        "aspect",
        "where",
        "basis"
      ],
      "title": "IncidentalDifference",
      "type": "object"
    },
    "PairEntry": {
      "additionalProperties": false,
      "properties": {
        "clean_item": {
          "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$",
          "title": "Clean Item",
          "type": "string"
        },
        "incidental_differences": {
          "items": {
            "$ref": "#/$defs/IncidentalDifference"
          },
          "title": "Incidental Differences",
          "type": "array"
        },
        "pair_id": {
          "minLength": 1,
          "title": "Pair Id",
          "type": "string"
        },
        "target_check": {
          "minLength": 1,
          "title": "Target Check",
          "type": "string"
        },
        "violating_item": {
          "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$",
          "title": "Violating Item",
          "type": "string"
        }
      },
      "required": [
        "pair_id",
        "clean_item",
        "violating_item",
        "target_check"
      ],
      "title": "PairEntry",
      "type": "object"
    },
    "TwinEntry": {
      "additionalProperties": false,
      "properties": {
        "base_item": {
          "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$",
          "title": "Base Item",
          "type": "string"
        },
        "twin_id": {
          "minLength": 1,
          "title": "Twin Id",
          "type": "string"
        },
        "twin_item": {
          "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$",
          "title": "Twin Item",
          "type": "string"
        }
      },
      "required": [
        "twin_id",
        "base_item",
        "twin_item"
      ],
      "title": "TwinEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "controls": {
      "items": {
        "$ref": "#/$defs/ControlEntry"
      },
      "title": "Controls",
      "type": "array"
    },
    "pairs": {
      "items": {
        "$ref": "#/$defs/PairEntry"
      },
      "title": "Pairs",
      "type": "array"
    },
    "schema_version": {
      "const": "registries/1.1.0",
      "default": "registries/1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "twins": {
      "items": {
        "$ref": "#/$defs/TwinEntry"
      },
      "title": "Twins",
      "type": "array"
    }
  },
  "title": "Registries",
  "type": "object"
}
